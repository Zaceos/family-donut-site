---
import { nav, site } from '../data/site';
export interface Props { currentPath: string }
const { currentPath } = Astro.props;
---
<header class="sticky top-0 z-40 backdrop-blur bg-[var(--color-cream)]/85 border-b border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="14" fill="#F2A48C" />
        <circle cx="16" cy="16" r="4" fill="#FBF6EF" />
        <circle cx="9" cy="11" r="1.2" fill="#5B5A8C" />
        <circle cx="22" cy="10" r="1" fill="#F2C969" />
        <circle cx="24" cy="20" r="1.3" fill="#6B3410" />
        <circle cx="10" cy="22" r="1.1" fill="#F2C969" />
        <circle cx="16" cy="6" r="0.9" fill="#5B5A8C" />
      </svg>
      <span class="font-display text-xl tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {nav.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`px-3 py-2 text-sm rounded-full transition-colors ${isActive ? 'bg-[var(--color-ink)] text-[var(--color-cream)]' : 'text-[var(--color-ink)] hover:bg-[var(--color-cream-deep)]'}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden md:block">
      <a href={site.phoneLink} class="btn btn-ghost text-sm py-2 px-4">
        {site.phone}
      </a>
    </div>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 -mr-2">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 card p-3 flex flex-col">
        {nav.map((item) => (
          <a href={item.href} class="px-3 py-2.5 rounded-xl hover:bg-[var(--color-cream-deep)] text-sm">{item.label}</a>
        ))}
        <a href={site.phoneLink} class="mt-2 btn btn-primary justify-center">{site.phone}</a>
      </div>
    </details>
  </div>
</header>
