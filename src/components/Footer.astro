---
import { site, nav } from '../data/site';
---
<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-cream-deep)]/60">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-14 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2">
        <svg width="36" height="36" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="14" fill="#F2A48C" />
          <circle cx="16" cy="16" r="4" fill="#FBF6EF" />
          <circle cx="9" cy="11" r="1.2" fill="#5B5A8C" />
          <circle cx="22" cy="10" r="1" fill="#F2C969" />
          <circle cx="24" cy="20" r="1.3" fill="#6B3410" />
        </svg>
        <span class="font-display text-2xl">{site.fullName}</span>
      </div>
      <p class="mt-4 max-w-md text-[var(--color-cocoa)] leading-relaxed">
        {site.tagline} A Northgate neighborhood shop, family-run by {site.owner} and family for over thirty years.
      </p>
      <p class="mt-6 text-sm text-[var(--color-cocoa-soft)]">
        Catch us at sunrise. We sell out by lunch.
      </p>
    </div>

    <div>
      <div class="eyebrow mb-4">Visit</div>
      <p class="text-sm leading-relaxed">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
      <p class="mt-3 text-sm"><a href={site.phoneLink} class="underline decoration-[var(--color-glaze-deep)] underline-offset-4">{site.phone}</a></p>
      <p class="mt-3 text-sm"><a href={site.social.facebook} class="underline decoration-[var(--color-glaze-deep)] underline-offset-4" target="_blank" rel="noopener">Facebook</a></p>
    </div>

    <div>
      <div class="eyebrow mb-4">Explore</div>
      <ul class="space-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-[var(--color-glaze-deep)] transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-6 flex flex-col md:flex-row gap-3 md:justify-between text-xs text-[var(--color-cocoa-soft)]">
      <p>© {new Date().getFullYear()} {site.fullName}. Family-run since 1993.</p>
      <p>
        Pitch concept site. Photography credited to Yelp reviewers (
        <a href={site.social.yelp} class="underline" target="_blank" rel="noopener">source</a>
        ) and to be replaced with owner-provided imagery before launch. Ratings shown are from Google and Yelp,
        verified 19 Aug 2026; review counts change over time. Hours and prices are drawn from
        public listings and should be confirmed with the owner before launch.
      </p>
    </div>
  </div>
</footer>
