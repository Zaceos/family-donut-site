---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address.full)}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.fullName + ' ' + site.address.full)}`;
---
<Layout title="Visit" pagePath="/visit" description="Hours, address, parking, and how to find Family Donut Shop in Northgate Seattle.">

  <section class="max-w-7xl mx-auto px-6 lg:px-10 pt-14 pb-12 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Visit</p>
      <h1 class="display-xl mt-4">2100 N Northgate Way, <span class="squiggle">Suite F</span>.</h1>
      <p class="mt-6 text-lg max-w-xl text-[var(--color-cocoa)] leading-relaxed">
        Just off North Northgate Way, in the strip plaza with Gyro Sababa and Teriyaki Plus. Free shared lot out front. Walk in. Get a number from the case. Pay at the back. Leave with a free donut hole.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={directionsUrl} target="_blank" rel="noopener" class="btn btn-primary">Get directions</a>
        <a href={site.phoneLink} class="btn btn-ghost">Call {site.phone}</a>
      </div>
    </div>

    <aside class="lg:col-span-5">
      <div class="card p-8">
        <p class="eyebrow">This week</p>
        <ul class="mt-5 space-y-3">
          {site.hours.map((h) => {
            const closed = h.open === 'Closed';
            return (
              <li class={`flex items-center justify-between text-sm ${closed ? 'text-[var(--color-cocoa-soft)]' : ''}`}>
                <span class="font-medium">{h.day}</span>
                <span class={closed ? 'italic' : 'font-display text-base'}>
                  {closed ? 'Closed' : `${h.open} – ${h.close}`}
                </span>
              </li>
            );
          })}
        </ul>
        <p class="mt-6 text-xs text-[var(--color-cocoa-soft)] leading-relaxed">
          We open at 5 a.m. Weekend cases can be picked clean by 10 a.m. If you want a specific donut, come earlier than you think you need to.
        </p>
      </div>
    </aside>
  </section>

  <section class="max-w-7xl mx-auto px-6 lg:px-10 py-12 grid lg:grid-cols-3 gap-6">
    {site.practicalities.map((p) => (
      <div class="border-t border-[var(--color-line)] pt-6">
        <p class="eyebrow">{p.label}</p>
        <p class="mt-2 text-[var(--color-cocoa)] leading-relaxed">{p.value}</p>
      </div>
    ))}
  </section>

  <section class="max-w-7xl mx-auto px-6 lg:px-10 pb-24">
    <div class="card overflow-hidden">
      <div class="aspect-[16/9] bg-[var(--color-cream-deep)] relative">
        <iframe
          title="Map to Family Donut Shop"
          src={`https://maps.google.com/maps?q=${encodeURIComponent(site.fullName + ' ' + site.address.full)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
          width="100%"
          height="100%"
          style="border:0; position:absolute; inset:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="p-8 grid sm:grid-cols-3 gap-6 items-center">
        <div class="sm:col-span-2">
          <p class="font-display text-2xl">{site.address.street}</p>
          <p class="text-[var(--color-cocoa)]">{site.address.city}, {site.address.state} {site.address.zip}</p>
          <p class="text-sm text-[var(--color-cocoa-soft)] mt-2">Northgate neighborhood. Free parking shared with the plaza.</p>
        </div>
        <div class="flex flex-wrap gap-3 sm:justify-end">
          <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost text-sm">Open in Maps</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
